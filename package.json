{
  "name": "llm-bridge",
  "version": "0.1.0",
  "description": "Delegate coding-agent tasks through a privacy-gated CLI and Node library",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "bin": {
    "llm-bridge": "bin/llm-bridge.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./providers/*": "./providers/*.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "providers",
    "README.md",
    "README.tr.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "test": "node --experimental-test-coverage --test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "scan:staged": "node scripts/scan-staged.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "author": "Yusuf Berat Zengin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YusufBeratZengin/llm-bridge.git"
  },
  "homepage": "https://github.com/YusufBeratZengin/llm-bridge#readme",
  "bugs": {
    "url": "https://github.com/YusufBeratZengin/llm-bridge/issues"
  },
  "keywords": [
    "llm",
    "ai-agents",
    "codex",
    "claude-code",
    "ollama",
    "cli",
    "delegation",
    "privacy-gate"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
